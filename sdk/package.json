{
  "version": "0.1.0",
  "name": "tributary-sdk",
  "description": "TypeScript client for the Tributary payment splitting contract on Stellar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tributary-protocol/tributary.git",
    "directory": "sdk"
  },
  "homepage": "https://tributary-omega.vercel.app",
  "keywords": [
    "stellar",
    "soroban",
    "payments",
    "splits"
  ],
  "type": "module",
  "main": "dist/tributary-sdk.umd.js",
  "exports": "./dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && npm run build:umd",
    "build:umd": "esbuild dist/index.js --bundle --format=iife --global-name=Tributary --outfile=dist/tributary-sdk.umd.js --platform=browser --target=es2020",
    "test": "npm run build && node --test dist/*.test.js umd.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
