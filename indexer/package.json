{
  "name": "tributary-indexer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Event-sourced indexer and query service for the Tributary splitter contract",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@stellar/stellar-sdk": "^14.5.0",
    "hono": "^4.7.10",
    "pg": "^8.13.6"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  }
}
